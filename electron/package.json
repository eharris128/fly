{
  "name": "fly-electron-shell",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "fly \u2014 a terminal for AI coding agents (Electron shell + Rust core)",
  "author": "Evan Harris <echarris@smcm.edu>",
  "homepage": "https://github.com/eharris128/fly",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox",
    "dist": "test -f ../dist/index.html || { echo 'electron/dist: ../dist missing \u2014 run pnpm build first' >&2; exit 1; }; rm -rf frontend && cp -r ../dist frontend && electron-builder --linux deb"
  },
  "build": {
    "appId": "dev.eharris128.fly",
    "productName": "fly",
    "directories": {
      "output": "dist-el"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "protocol.js",
      "recovery.js",
      "urgency.js",
      "crashed.html",
      "frontend/**"
    ],
    "extraResources": [
      {
        "from": "../core/target/release/fly",
        "to": "fly"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "executableName": "fly-shell",
      "category": "Development",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "fly-electron-shell"
        }
      }
    },
    "deb": {
      "packageName": "fly",
      "afterInstall": "deb/postinst.sh",
      "afterRemove": "deb/postrm.sh"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  }
}
